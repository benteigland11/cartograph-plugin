{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/skills-nudge.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = $env:PLUGIN_ROOT; if (-not $root) { $root = $env:CLAUDE_PLUGIN_ROOT }; & (Join-Path $root 'hooks\\skills-nudge.ps1')\"",
            "timeout": 5,
            "statusMessage": "Cartograph skills check"
          }
        ]
      }
    ]
  }
}
